# `npm/npm` is the virtual repo — the internal @runway packages plus a remote
# proxy of public npm — and the one endpoint for reads and publishes alike.
#
# Registry pin only, no credential. This file is committed, and pnpm discards
# the whole file when a `${VAR}` in it can't be expanded — the pin would vanish
# with the token and @runway/* would resolve off public npm. Credential-free, a
# missing token is a 401 instead. Auth comes from the user-level `~/.npmrc`: Bay
# mounts one into the build as the `artifactory_npmrc` secret, and locally the
# CLI writes those lines itself once IT's ARTIFACTORY_RESTRICTED_ACCESS_KEY is in
# your environment (`bay doctor` reports on both).
@runway:registry=https://artifactory.ops.runwayml.com/artifactory/api/npm/npm/
fetch-retries=5
fetch-retry-mintimeout=2000
prefer-offline=true
